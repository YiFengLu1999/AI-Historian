# Select the active chat provider and exact model for this run.
AIH_CHAT_PROVIDER=deepseek
AIH_CHAT_MODEL=deepseek-chat

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic OpenAI compatibility endpoint
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini OpenAI compatibility endpoint
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Qwen / DashScope OpenAI compatibility endpoint
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Generic or local OpenAI-compatible endpoint
AIH_COMPATIBLE_API_KEY=
AIH_COMPATIBLE_BASE_URL=https://your-endpoint.example/v1

# Optional embedding endpoint for embedding or hybrid retrieval.
AIH_EMBED_API_KEY=
AIH_EMBED_BASE_URL=https://your-embedding-endpoint.example/v1
AIH_EMBED_MODEL=your-embedding-model-id

# Shared runtime settings
AIH_PIPELINE_CONCURRENCY=4
AIH_REQUEST_TIMEOUT=300
AIH_CROSSDOC_SCOPE_MODE=episode_packet
AIH_CROSSDOC_SCOPE_SELECTOR=lexical
AIH_CROSSDOC_SCOPE_MAX_CASES=60
