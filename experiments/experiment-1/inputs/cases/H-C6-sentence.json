      "source_text": "高祖本纪",
      "crossdoc_enabled_by_design": true
    }
  },
  {
    "number": "94d18bb5-29cc-51b5-b0c3-70afe2b6f85b.8.10.3",
    "sentence": "萧何、曹参恐惧，翻过城墙依附刘季。",
    "characters": {
      "刘邦": true,
      "萧何": false
    },
    "Original_time_information": {
      "exist": false,
      "OTI": ""
    },
