  },
  {
    "number": "94d18bb5-29cc-51b5-b0c3-70afe2b6f85b.8.9.3",
    "sentence": "沛县县令恐惧，想要以沛具响应陈胜，",
    "characters": {
      "刘邦": true,
      "萧何": false
    },
    "Original_time_information": {
      "exist": false,
      "OTI": ""
    },
    "sink": {
      "Is_it_sinking": false,
      "reason": "..."
    },
    "Interlude": false,
