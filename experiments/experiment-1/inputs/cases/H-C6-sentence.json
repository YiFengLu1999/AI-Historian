      "part_id": "H-C6a",
      "short_id": "8.9.4",
      "source_text": "高祖本纪",
      "crossdoc_enabled_by_design": true
    }
  },
  {
    "number": "94d18bb5-29cc-51b5-b0c3-70afe2b6f85b.8.9.5",
    "sentence": "县令就派樊哙去召唤刘季，刘季的队伍已经近百人了。",
    "characters": {
      "刘邦": true,
      "萧何": false
    },
    "Original_time_information": {
      "exist": false,
      "OTI": ""
    },
