  },
  {
    "number": "94d18bb5-29cc-51b5-b0c3-70afe2b6f85b.8.25.3",
    "sentence": "项羽怨恨楚怀王不肯让他与沛公一起西进入关，而派他北上救赵，",
    "characters": {
      "刘邦": true
    },
    "Original_time_information": {
      "exist": false,
      "OTI": ""
    },
    "sink": {
      "Is_it_sinking": false,
