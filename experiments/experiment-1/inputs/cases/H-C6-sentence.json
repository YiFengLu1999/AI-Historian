      "source_text": "高祖本纪",
      "crossdoc_enabled_by_design": true
    }
  },
  {
    "number": "94d18bb5-29cc-51b5-b0c3-70afe2b6f85b.8.10.2",
    "sentence": "沛县县令又后悔了，恐怕刘季发生变故，就关闭城门，派人防守，（不让刘季进城，）打算杀掉萧何、曹参。",
    "characters": {
      "刘邦": true,
      "萧何": false
    },
    "Original_time_information": {
      "exist": false,
      "OTI": ""
    },
    "sink": {
      "Is_it_sinking": false,
      "reason": "..."
    },
