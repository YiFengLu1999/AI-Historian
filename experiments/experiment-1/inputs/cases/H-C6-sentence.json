    "experiment_case": {
      "case_id": "H-C6",
      "part_id": "H-C6a",
      "short_id": "8.10.6",
      "source_text": "高祖本纪",
      "crossdoc_enabled_by_design": true
    }
  },
  {
    "number": "94d18bb5-29cc-51b5-b0c3-70afe2b6f85b.8.10.7",
    "sentence": "刘季说：“天下正在混乱当中，诸侯都已起事，如果推选的将领不胜任，就会一败涂地。我不是吝惜自己的生命，只怕才劣力薄，不能保全父兄子弟。这是件大事，希望另外共同推选一位能够胜任的人。”",
    "characters": {
      "刘邦": true,
      "萧何": false
    },
    "Original_time_information": {
      "exist": false,
      "OTI": ""
    },
    "sink": {
      "Is_it_sinking": false,
      "reason": "..."
    },
    "Interlude": false,
    "crossDocTransfer": {
