    }
  },
  {
    "number": "94d18bb5-29cc-51b5-b0c3-70afe2b6f85b.8.10.4",
    "sentence": "刘季用帛写了一封信，",
    "characters": {
      "刘邦": true,
      "萧何": false
    },
    "Original_time_information": {
      "exist": false,
      "OTI": ""
    },
    "sink": {
