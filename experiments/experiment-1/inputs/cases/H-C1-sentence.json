  },
  {
    "number": "94d18bb5-29cc-51b5-b0c3-70afe2b6f85b.53.10.6",
    "sentence": "秦朝灭亡后，他沦为平民，家中贫穷，在长安城东种瓜。",
    "characters": {
      "萧何": true
    },
    "Original_time_information": {
