      "source_text": "高祖本纪",
      "crossdoc_enabled_by_design": true
    }
  },
  {
    "number": "94d18bb5-29cc-51b5-b0c3-70afe2b6f85b.8.10.1",
    "sentence": "于是樊哙跟着刘季来到沛县。",
    "characters": {
      "刘邦": true,
      "萧何": false
    },
    "Original_time_information": {
      "exist": false,
      "OTI": ""
    },
